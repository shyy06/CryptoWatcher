<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 仅用于系统托盘图标（System.Windows.Forms.NotifyIcon），不引入任何 NuGet 依赖 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <!-- 关闭隐式 using，全部 using 显式声明，行为完全可预期 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CryptoWatcher</RootNamespace>
    <AssemblyName>CryptoWatcher</AssemblyName>
    <ApplicationIcon>Assets\mainIcon.ico</ApplicationIcon>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Product>CryptoWatcher</Product>
    <AssemblyTitle>CryptoWatcher</AssemblyTitle>
    <Company>CryptoWatcher</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release 下不生成 .pdb，保证 publish 目录只有一个 exe -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\mainIcon.ico" />
  </ItemGroup>

</Project>
