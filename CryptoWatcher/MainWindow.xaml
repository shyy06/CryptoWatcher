<Window x:Class="CryptoWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CryptoWatcher"
        Height="580" Width="880" MinHeight="420" MinWidth="720"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets/mainIcon.ico"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- 无边框 + 原生边缘拖拽改变大小 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 自定义标题栏 ============ -->
            <Grid Grid.Row="0" Height="54" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource GlyphText}" FontSize="15"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CryptoWatcher" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SubTitle}" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}"
                            Click="Pin_Click" ToolTip="窗口总在最前">
                        <TextBlock Text="&#xE718;" Style="{StaticResource GlyphText}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="最小化到托盘">
                        <TextBlock Text="&#xE921;" Style="{StaticResource GlyphText}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="退出程序">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource GlyphText}" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ 工具栏 ============ -->
            <Grid Grid.Row="1" Margin="18,0,18,12">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Click="Add_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource GlyphText}" FontSize="13" />
                            <TextBlock Text="添加监测" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Click="Edit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource GlyphText}" FontSize="13" />
                            <TextBlock Text="编辑" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Click="Delete_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphText}" FontSize="13" />
                            <TextBlock Text="删除" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                        Click="Mini_Click" ToolTip="切换到桌面常驻的迷你窗口">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73F;" Style="{StaticResource GlyphText}" FontSize="13" />
                        <TextBlock Text="迷你模式" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ 监测列表 ============ -->
            <Border Grid.Row="2" Margin="18,0,18,14" CornerRadius="10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="关注项目" Margin="16,0,0,0"
                                   Style="{StaticResource ColumnHeaderText}" />
                        <TextBlock Grid.Column="1" Text="现价" Style="{StaticResource ColumnHeaderText}" />
                        <TextBlock Grid.Column="2" Text="涨跌" Style="{StaticResource ColumnHeaderText}" />
                        <TextBlock Grid.Column="3" Text="频率" Style="{StaticResource ColumnHeaderText}" />
                        <TextBlock Grid.Column="4" Text="状态" Style="{StaticResource ColumnHeaderText}" />
                    </Grid>

                    <ListBox x:Name="ItemsList" Grid.Row="1"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Style="{StaticResource ModernListBox}"
                             ItemContainerStyle="{StaticResource ModernListBoxItem}"
                             MouseDoubleClick="ItemsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Key}" Margin="16,0,0,0"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{Binding PriceText}"
                                               FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="up">
                                                        <Setter Property="Foreground" Value="{StaticResource RiseBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="down">
                                                        <Setter Property="Foreground" Value="{StaticResource FallBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" Text="{Binding ChangeText}"
                                               FontSize="12.5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="up">
                                                        <Setter Property="Foreground" Value="{StaticResource RiseBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="down">
                                                        <Setter Property="Foreground" Value="{StaticResource FallBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="3" Text="{Binding IntervalText}"
                                               FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />

                                    <TextBlock Grid.Column="4" Text="{Binding Status}"
                                               FontSize="12" Margin="0,0,16,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint" Grid.Row="1"
                               Text="还没有监测项，点击左上角「添加监测」开始"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- ============ 状态栏 ============ -->
            <Border Grid.Row="3" Height="32" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,0,150,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="v3.0 · WPF / .NET 8" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
