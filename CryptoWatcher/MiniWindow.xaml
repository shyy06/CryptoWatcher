<Window x:Class="CryptoWatcher.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CryptoWatcher 迷你窗"
        Width="140" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="恢复主界面" Click="Restore_Click" />
            <Separator />
            <MenuItem x:Name="TopmostItem" Header="总在最前" IsCheckable="True" IsChecked="True" Click="Topmost_Click" />
            <MenuItem x:Name="LockItem" Header="锁定位置" IsCheckable="True" Click="Lock_Click" />
            <MenuItem x:Name="ThroughItem" Header="鼠标穿透" IsCheckable="True" Click="Through_Click" />
            <Separator />
            <MenuItem Header="退出程序" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- 隐蔽优先：窄条 + 小圆角 + 高透明底 + 极淡描边。
         去掉阴影是为了长时间置顶时尽量不遮挡、不压暗下方内容 -->
    <Border x:Name="Card" Margin="5" CornerRadius="7"
            Background="#99FFFFFF" Padding="8,3,8,4"
            BorderBrush="#240F172A" BorderThickness="1">

        <StackPanel>
            <!-- 极窄拖拽条：双击即恢复主界面 -->
            <Grid x:Name="Header" Height="14" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="CW" FontSize="9" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Button Style="{StaticResource IconButton}" Width="14" Height="14"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Restore_Click" ToolTip="恢复主界面">
                    <TextBlock Text="&#xE73F;" Style="{StaticResource GlyphText}" FontSize="8" />
                </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding}" Margin="0,1,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="19">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="10.5"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextSecondaryBrush}" />

                            <TextBlock Grid.Column="1" Text="{Binding PriceText}" Margin="6,0,0,0"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Direction}" Value="up">
                                                <Setter Property="Foreground" Value="{StaticResource RiseBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="down">
                                                <Setter Property="Foreground" Value="{StaticResource FallBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
