<Window x:Class="CryptoWatcher.Views.AlertEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加价格提醒"
        Width="430" Height="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Border Margin="16" CornerRadius="12" Background="#FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.20" Color="#0F172A" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="添加价格提醒" Margin="20,0,0,0"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,0,20,0">
                <TextBlock Text="触发条件" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="TypeCombo" Style="{StaticResource ModernComboBox}" />

                <TextBlock Text="目标价位" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                <TextBox x:Name="PriceBox" Style="{StaticResource ModernTextBox}" />
                <TextBlock Text="例如 65000 或 0.00001234" Style="{StaticResource HintText}" />
            </StackPanel>

            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            MinWidth="84" Click="Cancel_Click" />
                    <Button Content="确定" Style="{StaticResource PrimaryButton}"
                            MinWidth="84" Margin="10,0,0,0" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
