<Window x:Class="CryptoWatcher.Views.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加监测项"
        Width="500" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Border Margin="16" CornerRadius="12" Background="#FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.20" Color="#0F172A" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="添加监测项" Margin="20,0,0,0"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Style="{StaticResource IconButton}" Margin="0,0,14,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Cancel_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource GlyphText}" FontSize="14" />
                </Button>
            </Grid>

            <!-- 表单 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0">
                <StackPanel>
                    <TextBlock Text="币种代码" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CoinCombo" Style="{StaticResource ModernComboBox}"
                              IsEditable="True" IsTextSearchEnabled="False" />
                    <TextBlock Text="可直接输入，也可下拉选择热门币种（如 BTC、ETH、SOL）"
                               Style="{StaticResource HintText}" />

                    <TextBlock Text="计价币种" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                    <ComboBox x:Name="BaseCombo" Style="{StaticResource ModernComboBox}" IsEditable="True" />

                    <TextBlock Text="刷新间隔（秒）" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                    <ComboBox x:Name="IntervalCombo" Style="{StaticResource ModernComboBox}" IsEditable="True" />
                    <TextBlock Text="6 路交易所接口同时竞速，取最快响应" Style="{StaticResource HintText}" />

                    <Grid Margin="0,20,0,8">
                        <TextBlock Text="价格提醒" VerticalAlignment="Center"
                                   Style="{StaticResource FieldLabel}" Margin="0" />
                        <Button Content="+ 添加提醒" Style="{StaticResource SecondaryButton}" Padding="10,5"
                                HorizontalAlignment="Right" Click="AddAlert_Click" />
                    </Grid>

                    <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            MinHeight="100" Padding="12,4" Margin="0,0,0,4">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding AlertRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding TypeText}" FontSize="12.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />

                                            <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="13"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />

                                            <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                    Width="26" Height="26" Click="RemoveAlert_Click"
                                                    ToolTip="移除该提醒">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphText}" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoAlertHint" Text="暂无提醒，可按需添加"
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            MinWidth="90" Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}"
                            MinWidth="90" Margin="10,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
