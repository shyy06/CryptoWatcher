<?xml version="1.0" encoding="utf-8"?>
<!--
  本机全局 NuGet 源中包含 HTTP 源（http://svn.geeran.cn:8000/nuget），
  新版 NuGet 默认拒绝 HTTP 源并抛出 NU1302。
  本项目零第三方依赖，这里直接清空继承来的源，只保留官方 HTTPS 源，最稳妥。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
